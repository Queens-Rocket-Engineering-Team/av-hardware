	(text "DAT2: \n\nDAT3:\n\nCMD:\n\nVDD: 3.3V from ORing\n\nCLK:\n\nVSS:\n\nDAT0:\n\nDAT1:\n\nDET:\n\nSHIELD: GND\n\n-Pull up resitors according to the table on claude\n-Hierarchy labels for the pins to go on the STM32"
		(exclude_from_sim no)
		(at 41.91 88.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "0f06fb37-e086-45cf-bd03-99d75efde27f")
	)
	(text "notes\n\n- learn SDMMC. what does each pin do. what is the sequence of events for a write. \n(i.e. 1st pull CMD low, etc.., and write notes on the Notion)\n\n- let's add a ferrite bead to add more stability to the power-line\n- let's also add a power switch to switch SD card on/off (start with a GPIO-driven PFET)\n- let's add ESD protection since these connections are coming off-board (TPD6E001)\n- let's add an LED that uses the DET pin to turn on when the card is in (this pin is active low)"
		(exclude_from_sim no)
		(at 118.364 59.182 0)
		(effects
			(font
				(size 1.27 1.27)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "ae5f5d99-85bc-4593-a1ec-88ec34dbb992")
	)
