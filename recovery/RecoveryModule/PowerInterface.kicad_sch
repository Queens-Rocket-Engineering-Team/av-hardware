	)
	(text "The 3.3V backplane is inverted with an NMOS \nto pull the enable pin LOW and turn it OFF\nwhen the board is in the stack. A pull-up resistor\nestablishes a default ON state. "
		(exclude_from_sim no)
		(at 31.75 176.784 0)
		(effects
			(font
				(size 1.27 1.27)
				(thickness 0.1588)
				(color 0 0 0 1)
			)
			(justify left)
		)
		(uuid "e2aed5bb-b693-449a-8801-5e25cbf5b046")
	)
	(text "Vs 	= 3.3 V\nVf 	= 2.0 V\nI  	= 10 mA = 0.01 A\nR  	= 1.3 / 0.01 = 130 R (~150 R)"
		(exclude_from_sim no)
		(at 266.192 76.962 0)
		(effects
			(font
